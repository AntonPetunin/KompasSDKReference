{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 5
  },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../Build/Obj/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "WITH_PCH": "ON",
        "WITH_MODULES": "OFF"
      }
    },
    {
      "name": "windows-default",
      "hidden": true,
      "toolset": {
        "value": "version=14.42",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "WindowsSDKVersion": "10.0.19041.0"
      }
    },
    {
      "name": "debug-default",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WITH_TESTS": "ON",
        "OUTPUT_DIRECTORY": "${sourceDir}/../Build/Exe/${presetName}",
        "KOMPAS_OUTPUT_DIR": "$env{KOMPAS_WRK}/Build/Exe/${presetName}"
      }
    },
    {
      "name": "release-default",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "OUTPUT_DIRECTORY": "${sourceDir}/../Build/Exe/${presetName}",
        "KOMPAS_OUTPUT_DIR": "$env{KOMPAS_SDK}/../Bin"
      }
    },
    {
      "name": "release-default-WRK",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfoWRK",
        "OUTPUT_DIRECTORY": "${sourceDir}/../Build/Exe/${presetName}",
        "KOMPAS_OUTPUT_DIR": "$env{KOMPAS_WRK}/Build/Exe/${presetName}"
      }
    },
    {
      "name": "clang-cl-default",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "${sourceDir}/../../../../../Tools/Clang/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "${sourceDir}/../../../../../Tools/Clang/clang-cl.exe",
        "CMAKE_LINKER": "${sourceDir}/../../../../../Tools/Clang/lld-link.exe",
        "CMAKE_CXX_LINKER_LAUNCHER": "${sourceDir}/../../../../../Tools/Clang/clang-cl-wrapper.exe",
        "CMAKE_CXX_COMPILER_LAUNCHER": "${sourceDir}/../../../../../Tools/Clang/clang-cl-wrapper.exe",
        "WITH_TESTS": "ON",
        "WITH_PCH": "ON",
        "WITH_MODULES": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "clang-linux-default",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_LINK_DEPENDS_NO_SHARED": "ON",
        "CMAKE_LINK_WHAT_YOU_USE": "ON",
        "WITH_TESTS": "ON",
        "WITH_MOLD": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "Debug-x64",
      "displayName": "Debug-x64",
      "inherits": [
        "default",
        "windows-default",
        "debug-default"
      ],
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "PLATFORM": "x64"
      }
    },
    {
      "name": "Release-x64",
      "displayName": "Release-x64",
      "inherits": [
        "default",
        "windows-default",
        "release-default"
      ],
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "PLATFORM": "x64"
      }
    },
    {
      "name": "xClangCL-Debug-x64",
      "displayName": "xClangCL-Debug-x64",
      "inherits": [
        "clang-cl-default",
        "debug-default",
        "windows-default",
        "default"
      ]
    },
    {
      "name": "xClangCL-Release-x64",
      "displayName": "xClangCL-Release-x64",
      "inherits": [
        "clang-cl-default",
        "release-default",
        "windows-default",
        "default"
      ]
    },
    {
      "name": "Clang-Debug-x64-Linux",
      "displayName": "Clang-Debug-x64-Linux",
      "inherits": [
        "clang-linux-default",
        "debug-default",
        "default"
      ],
      "cacheVariables": {
        "PURE_QT": "ON"
      }
    },
    {
      "name": "Clang-Release-x64-Linux",
      "displayName": "Clang-Release-x64-Linux",
      "inherits": [
        "clang-linux-default",
        "release-default",
        "default"
      ],
      "cacheVariables": {
        "PURE_QT": "ON"
      }
    }
    ,
    {
      "name": "Clang-Release-x64-Linux-WRK",
      "displayName": "Clang-Release-x64-Linux-WRK",
      "inherits": [
        "clang-linux-default",
        "release-default-WRK",
        "default"
      ],
      "cacheVariables": { 
        "KOMPAS_OUTPUT_DIR": "$env{KOMPAS_WRK}/Build/Exe/Clang-Debug-x64-Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug-x64",
      "configurePreset": "Debug-x64"
    },
    {
      "name": "Debug-x64-keep-going",
      "configurePreset": "Debug-x64",
      "nativeToolOptions": [
        "-k0"
      ]
    },
    {
      "name": "Release-x64",
      "configurePreset": "Release-x64"
    },
    {
      "name": "xClangCL-Debug-x64",
      "configurePreset": "xClangCL-Debug-x64",
      "nativeToolOptions": [
        "-k0"
      ]
    },
    {
      "name": "Clang-Debug-x64-Linux",
      "configurePreset": "Clang-Debug-x64-Linux"
    },
    {
      "name": "Clang-Release-x64-Linux",
      "configurePreset": "Clang-Release-x64-Linux"
    }
  ]
}